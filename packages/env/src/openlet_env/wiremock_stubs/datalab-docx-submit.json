{
  "request": {
    "method": "POST",
    "urlPath": "/api/v1/convert",
    "headers": {
      "X-Api-Key": {
        "equalTo": "datalab-test-only"
      }
    },
    "multipartPatterns": [
      {
        "headers": {
          "Content-Disposition": {
            "contains": "filename=\"input.docx\""
          }
        }
      },
      {
        "headers": {"Content-Disposition": {"contains": "name=\"output_format\""}},
        "bodyPatterns": [
          {
            "equalTo": "markdown"
          }
        ]
      }
    ]
  },
  "response": {
    "status": 200,
    "headers": {
      "Content-Type": "application/json"
    },
    "jsonBody": {
      "success": true,
      "request_check_url": "/datalab/docx"
    }
  }
}
