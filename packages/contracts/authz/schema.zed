definition account {
	relation self: account
	relation owner: account
	permission read = self + owner
	permission update = self + owner
}

definition filesystem {
	relation reader: account | workspace#owner | workspace#admin | workspace#member
	relation deleter: account | workspace#owner
	permission read = reader + deleter
	permission delete = deleter
}

definition scope {
	relation manager: account | workspace#owner | workspace#admin
	relation editor: account | workspace#member
	relation viewer: account
	permission read_metadata = viewer + editor + manager
	permission read_content = viewer + editor + manager
	permission write = editor + manager
	permission trash = editor + manager
	permission restore = editor + manager
	permission purge = manager
	permission manage_access = manager
}

definition workspace {
	relation owner: account
	relation admin: account
	relation member: account
	permission read = owner + admin + member
	permission update = owner + admin
	permission manage_members = owner + admin
	permission delete = owner
}
