logging {
  level = "warn"
  format = "json"
}

otelcol.receiver.otlp "openlet" {
  grpc { endpoint = "0.0.0.0:4317" }
  http { endpoint = "0.0.0.0:4318" }
  output {
    traces = [otelcol.processor.memory_limiter.openlet.input]
    metrics = [otelcol.processor.memory_limiter.openlet.input]
  }
}

otelcol.processor.memory_limiter "openlet" {
  check_interval = "1s"
  limit = "192MiB"
  spike_limit = "48MiB"
  output {
    traces = [otelcol.processor.batch.openlet.input]
    metrics = [otelcol.processor.batch.openlet.input]
  }
}

otelcol.processor.batch "openlet" {
  timeout = "5s"
  send_batch_size = 512
  send_batch_max_size = 1024
  output {
    traces = [otelcol.processor.transform.tempo.input, otelcol.processor.filter.langfuse.input]
    metrics = [otelcol.processor.transform.metrics.input]
  }
}

// The Python Langfuse SDK already exports its own observations directly.
otelcol.processor.filter "langfuse" {
  error_mode = "propagate"
  traces {
    span = [
      `resource.attributes["service.name"] != "openlet-letfs"`,
      `not (attributes["langfuse.observation.type"] == "retriever" or name == "query_embedding" or name == "rerank")`,
    ]
  }
  output { traces = [otelcol.exporter.otlphttp.langfuse.input] }
}

otelcol.auth.basic "langfuse" {
  username = sys.env("LANGFUSE_PUBLIC_KEY")
  password = sys.env("LANGFUSE_SECRET_KEY")
}

otelcol.exporter.otlphttp "langfuse" {
  client {
    endpoint = sys.env("LANGFUSE_OTLP_ENDPOINT")
    auth = otelcol.auth.basic.langfuse.handler
  }
}

otelcol.processor.transform "tempo" {
  error_mode = "propagate"
  trace_statements {
    context = "span"
    statements = [
      `delete_matching_keys(attributes, "^(langfuse\\.(observation|trace)\\.(input|output)|gen_ai\\.(input|output|prompt|completion|system_instructions)|llm\\.(prompts|completions)|input\\.value|output\\.value|tool\\.(parameters|arguments|result)).*")`,
    ]
  }
  trace_statements {
    context = "spanevent"
    statements = [
      `delete_matching_keys(attributes, "^(gen_ai\\.(input|output|prompt|completion|content)|input\\.value|output\\.value).*")`,
    ]
  }
  output { traces = [otelcol.exporter.otlphttp.tempo.input] }
}

otelcol.auth.basic "tempo" {
  username = sys.env("GRAFANA_TRACES_USER")
  password = sys.env("GRAFANA_CLOUD_TOKEN")
}

otelcol.exporter.otlphttp "tempo" {
  client {
    endpoint = sys.env("GRAFANA_TRACES_ENDPOINT")
    auth = otelcol.auth.basic.tempo.handler
  }
}

otelcol.processor.transform "metrics" {
  error_mode = "ignore"
  metric_statements {
    context = "datapoint"
    statements = [
      `set(attributes["environment"], resource.attributes["deployment.environment.name"])`,
      `set(attributes["service_name"], resource.attributes["service.name"])`,
      `set(attributes["service_name"], attributes["service.name"]) where attributes["service.name"] != nil`,
      `delete_key(attributes, "service.name")`,
      `set(attributes["worker_role"], resource.attributes["worker.role"]) where resource.attributes["worker.role"] != nil`,
    ]
  }
  output { metrics = [otelcol.exporter.prometheus.cloud.input] }
}

otelcol.exporter.prometheus "cloud" {
  forward_to = [prometheus.relabel.essential.receiver]
  include_scope_labels = false
  include_target_info = false
  resource_to_telemetry_conversion = false
}

// Keep operational metrics used by Openlet dashboards; avoid full dependency internals.
prometheus.relabel "essential" {
  forward_to = [prometheus.remote_write.cloud.receiver]
  rule {
    source_labels = ["__name__"]
    regex = "up|openlet_.*|rpc_(server|client)_call_duration_seconds.*|http_server_(duration_milliseconds|request_duration_seconds).*|process_(memory_usage_bytes|resident_memory_bytes|cpu_time_seconds_total|cpu_seconds_total|thread_count|open_fds|max_fds|start_time_seconds)|go_(memory_used_bytes|goroutine_count|goroutines)|temporal_(activity_(schedule_to_start_latency_seconds|execution_latency_seconds).*|activity_execution_failed_total|worker_task_slots_(available|used))|service_(requests|errors|error_with_type)|node_(cpu_seconds_total|load1|load5|load15|memory_(MemTotal|MemAvailable)_bytes|filesystem_(avail_bytes|size_bytes|readonly)|disk_(read|written)_bytes_total|network_(receive|transmit)_(bytes|errs|drop)_total)|container_(cpu_usage_seconds_total|memory_working_set_bytes|network_(receive|transmit)_bytes_total)|pg_(up|stat_database_(numbackends|xact_commit|xact_rollback|deadlocks|blks_hit|blks_read)|locks_count|database_size_bytes)|redis_(up|memory_used_bytes|memory_max_bytes|evicted_keys_total|connected_clients|commands_processed_total|rejected_connections_total)|grpc_server_handled_total|spicedb_cache_(hits|misses)_total|rest_responses_total|collections_total|envoy_http_downstream_rq_(total|[245]xx)|otelcol_exporter_.*|prometheus_remote_storage_(samples_failed_total|samples_pending)|litellm_(requests_metric|request_total_latency_metric.*|input_tokens_metric|output_tokens_metric|spend_metric|deployment_failure_responses|deployment_success_responses).*"
    action = "keep"
  }
}

prometheus.remote_write "cloud" {
  endpoint {
    url = sys.env("GRAFANA_METRICS_ENDPOINT")
    basic_auth {
      username = sys.env("GRAFANA_METRICS_USER")
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }
}

prometheus.exporter.self "alloy" {}
prometheus.exporter.unix "host" {
  rootfs_path = "/rootfs"
  procfs_path = "/host/proc"
  sysfs_path = "/sys"
}
prometheus.exporter.cadvisor "containers" {
  docker_host = "unix:///var/run/docker.sock"
  docker_only = true
  store_container_labels = false
  enabled_metrics = ["cpu", "memory", "network"]
  storage_duration = "5m"
}
prometheus.exporter.postgres "postgres" {
  data_source_names = [sys.env("POSTGRES_METRICS_DSN")]
}

prometheus.scrape "native" {
  targets = [
    {__address__ = "spicedb:9090", job = "spicedb"},
    {__address__ = "temporal:9090", job = "temporal"},
    {__address__ = "envoy:9901", __metrics_path__ = "/stats/prometheus", job = "envoy"},
  ]
  scrape_interval = "60s"
  forward_to = [prometheus.relabel.essential.receiver]
}
prometheus.scrape "litellm" {
  targets = [{__address__ = "litellm:4000", job = "litellm"}]
  authorization {
    type = "Bearer"
    credentials = sys.env("LITELLM_MASTER_KEY")
  }
  scrape_interval = "60s"
  forward_to = [prometheus.relabel.essential.receiver]
}
prometheus.scrape "qdrant" {
  targets = [{__address__ = sys.env("QDRANT_METRICS_ADDRESS"), job = "qdrant"}]
  http_headers = {"api-key" = [sys.env("QDRANT_API_KEY")]}
  scrape_interval = "60s"
  forward_to = [prometheus.relabel.essential.receiver]
}
prometheus.exporter.redis "cache" {
  redis_addr = sys.env("REDIS_ADDRESS")
  redis_password = sys.env("REDIS_PASSWORD")
}
prometheus.scrape "redis" {
  targets = [] // Redis targets are enabled by configure.py with the Leta profile.
  scrape_interval = "60s"
  forward_to = [prometheus.relabel.essential.receiver]
}
prometheus.scrape "alloy" {
  targets = prometheus.exporter.self.alloy.targets
  scrape_interval = "60s"
  forward_to = [prometheus.relabel.essential.receiver]
}
prometheus.scrape "host" {
  targets = prometheus.exporter.unix.host.targets
  scrape_interval = "60s"
  forward_to = [prometheus.relabel.essential.receiver]
}
prometheus.scrape "containers" {
  targets = prometheus.exporter.cadvisor.containers.targets
  scrape_interval = "60s"
  forward_to = [prometheus.relabel.essential.receiver]
}
prometheus.scrape "postgres" {
  targets = prometheus.exporter.postgres.postgres.targets
  scrape_interval = "60s"
  forward_to = [prometheus.relabel.essential.receiver]
}

discovery.docker "openlet" {
  host = "unix:///var/run/docker.sock"
  filter {
    name = "label"
    values = ["com.docker.compose.project=" + sys.env("COMPOSE_PROJECT_NAME")]
  }
}
discovery.relabel "logs" {
  targets = discovery.docker.openlet.targets
  rule {
    source_labels = ["__meta_docker_container_label_com_docker_compose_service"]
    target_label = "service"
  }
  rule {
    target_label = "environment"
    replacement = sys.env("OPENLET_ENVIRONMENT")
  }
}
loki.source.docker "openlet" {
  host = "unix:///var/run/docker.sock"
  targets = discovery.relabel.logs.output
  forward_to = [loki.process.openlet.receiver]
}
loki.process "openlet" {
  stage.json { expressions = {level = "level"} }
  stage.labels { values = {level = ""} }
  forward_to = [loki.write.cloud.receiver]
}
loki.write "cloud" {
  endpoint {
    url = sys.env("GRAFANA_LOGS_ENDPOINT")
    basic_auth {
      username = sys.env("GRAFANA_LOGS_USER")
      password = sys.env("GRAFANA_CLOUD_TOKEN")
    }
  }
}
