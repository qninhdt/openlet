{
  "name": "openlet-web",
  "main": "worker.js",
  "compatibility_date": "2026-11-17",
  "workers_dev": false,
  "routes": [{ "pattern": "openlet.qninhdt.com", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  }
}
