{
  "name": "@openlet/letfs",
  "private": true,
  "scripts": {
    "build": "go build -o bin/letfs ./cmd/server",
    "check": "gofmt -l cmd internal | awk '{print} END {exit NR != 0}' && go vet -tags integration,workflow ./...",
    "test": "go test ./...",
    "test:integration": "go test -race -tags integration ./...",
    "test:replay": "go test -tags replay ./internal/temporal -count=1",
    "test:workflow": "go test -race -tags workflow ./internal/temporal -count=1"
  },
  "dependencies": {
    "@openlet/go": "workspace:*"
  }
}
