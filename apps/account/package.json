{
  "name": "@openlet/account",
  "private": true,
  "scripts": {
    "build": "go build -o bin/account ./cmd/server",
    "check": "gofmt -l . | awk '{print} END {exit NR != 0}' && go vet -tags integration ./...",
    "test": "go test ./...",
    "test:integration": "go test -tags integration ./...",
    "test:replay": "go test -tags replay ./internal/temporal -count=1",
    "test:workflow": "go test -tags workflow ./internal/temporal -count=1"
  }
}
