    {
      "type": "function",
      "function": {
        "name": "hitl_ask",
        "description": "Ask any current workspace member; the answer arrives later in your inbox.",
        "parameters": {
          "type": "object",
          "properties": {
            "recipient_user_id": {
              "type": "string",
              "format": "uuid"
            },
            "title": {
              "type": "string",
              "minLength": 1
            },
            "questions": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "text": {
                    "type": "string",
                    "minLength": 1
                  },
                  "options": {
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    },
                    "minItems": 1,
                    "description": "Omit for a free-text answer."
                  },
                  "multiple": {
                    "type": "boolean",
                    "default": false,
                    "description": "Allow several choices; requires options."
                  }
                },
                "required": [
                  "text"
                ],
                "additionalProperties": false
              },
              "minItems": 1
            }
          },
          "required": [
            "recipient_user_id",
            "questions"
          ],
          "additionalProperties": false
        }
      }
    },
    {
      "type": "function",
      "function": {
        "name": "hitl_request",
