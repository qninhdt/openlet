    {
      "type": "function",
      "function": {
        "name": "schedule_create",
        "description": "Schedule an inbox instruction for yourself or a box. Choose exactly one: at, after_seconds, every_seconds, calendar.",
        "parameters": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string",
              "minLength": 1
            },
            "content": {
              "type": "string",
              "minLength": 1
            },
            "at": {
              "type": "string",
              "format": "date-time"
            },
            "after_seconds": {
              "type": "integer",
              "minimum": 0
            },
            "every_seconds": {
              "type": "integer",
              "minimum": 1
            },
            "calendar": {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "second",
                  "minute",
                  "hour",
                  "day_of_month",
                  "month",
                  "year",
                  "day_of_week"
                ]
              },
              "additionalProperties": {
                "type": "array",
                "items": {
                  "type": "integer",
                  "minimum": 0
                },
                "minItems": 1
              },
              "minProperties": 1,
              "description": "All fields must match; Sunday=0. Omitted second/minute/hour=0; other fields unrestricted."
            },
            "starts_at": {
              "type": "string",
              "format": "date-time",
              "description": "Recurring start; also anchors an interval."
            },
            "ends_at": {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Recurring cutoff; null clears it."
            },
            "timezone": {
              "type": "string",
              "minLength": 1,
              "description": "IANA name; defaults to task timezone, otherwise UTC."
            },
            "target_box_id": {
              "type": "string",
              "format": "uuid",
              "description": "Omit to target yourself."
            }
          },
          "required": [
            "content"
          ],
          "additionalProperties": false
        }
      }
    },
