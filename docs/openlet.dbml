Project Openlet {
  database_type: 'PostgreSQL'
  Note: '''
    Monolith view of the implemented Openlet application data model, 2026-11-03.
    Sources: apps/account/migrations/0001_initial.sql, apps/workspace/migrations/0001_initial.sql and apps/letfs/migrations/0001_initial.sql.
    Application tables share one namespace in this view. Workspace and Letfs receipt tables are named by owner.
    Blue references are logical application relationships; other references are physical foreign keys.
    Partial-index predicates are preserved in index notes because DBML cannot express PostgreSQL WHERE predicates. This diagram is not a migration script.
    Qdrant stores derived vectors with payload filesystem_id, source_id, file_id, generation, embedding_model, vector_dimension and text. PostgreSQL owns metadata and visibility.
    S3 stores object payloads. ZIP downloads stream over HTTP without stored archives. SpiceDB stores derived authorization relationships and repository-defined role/action policy; canonical membership stays in application tables. Temporal persistence and migration-runner bookkeeping are infrastructure-managed and are outside the application ERD.
  '''
}

Table "users" {
  Note: 'Application identity and profile. Clerk identity provides natural onboarding idempotency; Workspace returns its owned ID.'

  "id" uuid [pk]
  "clerk_id" text [unique, not null, check: `length(clerk_id) BETWEEN 1 AND 200`]
  "display_name" text [not null, check: `length(display_name) <= 100`, default: '']
  "avatar_url" text [not null, check: `length(avatar_url) <= 2048`, default: '']
  "status" text [not null, check: `status IN ('provisioning','active','failed')`, default: 'provisioning']
  "initial_workspace_id" uuid [unique]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Checks {
    `status != 'active' OR initial_workspace_id IS NOT NULL`
  }

  Indexes {
    (updated_at, id) [name: 'pending_onboarding', note: "Partial index predicate: status='provisioning'"]
  }
}

Table "workspaces" {
  Note: 'Collaboration boundary with lifecycle, optimistic revision and stable provisioning identity.'

  "id" uuid [pk]
  "name" text [not null, check: `length(name) BETWEEN 1 AND 100`]
  "status" text [not null, check: `status IN ('provisioning','active','deleting','deleted','failed')`, default: 'provisioning']
  "quota_bucket_id" uuid [unique]
  "filesystem_id" uuid [unique]
  "root_id" uuid [unique]
  "limit_bytes" bigint [not null, check: `limit_bytes >= 0`]
  "revision" bigint [not null, check: `revision > 0`, default: 1]
  "error_code" text
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Checks {
    `status != 'active' OR (quota_bucket_id IS NOT NULL AND filesystem_id IS NOT NULL AND root_id IS NOT NULL)`
  }

  Indexes {
    (updated_at, id) [name: 'workspace_pending_lifecycle', note: "Partial index predicate: status IN ('provisioning','deleting')"]
  }
}

Table "workspace_members" {
  Note: 'Workspace membership and role. The workspace_one_owner index applies ONLY WHERE role = owner, allowing many editors and viewers.'

  "workspace_id" uuid [not null]
  "user_id" uuid [not null]
  "role" text [not null, check: `role IN ('owner','editor','viewer')`]
  "joined_at" timestamptz [not null, default: `now()`]

  Indexes {
    (workspace_id, user_id) [pk]
    workspace_id [unique, name: "workspace_one_owner", note: 'Partial index predicate: role=\'owner\'']
    (user_id, workspace_id) [name: "workspace_members_by_user"]
  }
}

Table "workspace_idempotency_keys" {
  Note: 'Caller-scoped creation receipt and resource identity. Expires 24h after logical completion.'
  "actor_id" uuid [not null]
  "request_key" uuid [not null]
  "request_hash" text [not null]
  "workspace_id" uuid [not null]
  "expires_at" timestamptz
  Indexes {
    (actor_id, request_key) [pk]
    expires_at [name: 'workspace_receipt_expiry', note: 'Partial index predicate: expires_at IS NOT NULL']
  }
}

Table "letfs_idempotency_keys" {
  Note: 'Physical table: letfs.public.idempotency_keys. Scoped create/upload/copy/process and service provisioning receipts; result is operation-specific JSON. Incomplete receipts remain pinned; terminal completion starts a 24-hour expiry. Provisioning receipts are released after storage references are durable. scope is a user/service scope string, not a UUID foreign key.'
  "scope" text [not null]
  "operation" text [not null]
  "request_key" text [not null]
  "request_hash" text [not null]
  "result" jsonb [not null]
  "expires_at" timestamptz
  Indexes {
    (scope, operation, request_key) [pk]
    expires_at [name: 'letfs_receipt_expiry', note: 'Partial index predicate: expires_at IS NOT NULL']
  }
}

Table "workspace_invitations" {
  Note: 'Email-bound invitations. Only the SHA-256 token hash is persisted; acceptance records the accepting user.'

  "id" uuid [pk]
  "workspace_id" uuid [not null]
  "email" text [not null, check: `length(email) BETWEEN 3 AND 254`]
  "role" text [not null, check: `role IN ('editor','viewer')`]
  "token_hash" bytea [unique, not null, check: `octet_length(token_hash)=32`]
  "expires_at" timestamptz [not null]
  "status" text [not null, check: `status IN ('pending','revoked','accepted','expired')`, default: 'pending']
  "accepted_user_id" uuid
  "created_at" timestamptz [not null, default: `now()`]

  Checks {
    `(status='accepted')=(accepted_user_id IS NOT NULL)`
  }

  Indexes {
    (workspace_id,email) [unique, name: "workspace_pending_invitation", note: "Partial index: status=pending"]
    (workspace_id, id) [name: "workspace_invitation_page"]
  }
}

Table "files" {
  "media_type" text
  "title" text
  "description" text
  "semantic_type" text
  "context" text

  Note: 'One payload per file node. Inline bytes and immutable S3 object keys are mutually exclusive; directories have no payload row.'

  "node_id" uuid [pk, not null]
  "storage_kind" text [not null]
  "inline_bytes" bytea
  "object_key" text [unique]

  "desired_generation" bigint [not null, default: 0, check: `desired_generation >= 0`]
  "processing_format" text
  "publication_status" text [not null, default: 'not_required', check: `publication_status IN ('not_required','pending','parsed','enriched','ready','failed','index_failed')`]
  "processing_error" text
  "processing_updated_at" timestamptz [not null, default: `now()`]

  Indexes {
    (processing_updated_at, node_id) [name: 'processing_dispatch', note: "Partial index predicate: publication_status IN ('pending','parsed','enriched')"]
  }

  Checks {
    `publication_status='not_required' OR (desired_generation>0 AND processing_format IS NOT NULL)`
    `(((storage_kind = 'inline'::text) AND (inline_bytes IS NOT NULL) AND (object_key IS NULL)) OR ((storage_kind = 'object'::text) AND (inline_bytes IS NULL) AND (object_key IS NOT NULL)))` [name: 'files_payload_check']
    `(storage_kind = ANY (ARRAY['inline'::text, 'object'::text]))` [name: 'files_storage_kind_check']
  }
}

Table "filesystems" {
  Note: 'Namespace and node-count budget. root_id can be NULL during teardown; an active filesystem must retain its root. The composite filesystem_root foreign key is DEFERRABLE INITIALLY DEFERRED.'

  "id" uuid [pk, not null]
  "bucket_id" uuid [not null]
  "root_id" uuid
  "state" text [not null, default: `'active'::text`]
  "node_count" bigint [not null, default: 1]
  "created_at" timestamptz [not null, default: `now()`]

  Checks {
    `((state <> 'active'::text) OR (root_id IS NOT NULL))` [name: 'filesystem_live_root']
    `(node_count >= 0)` [name: 'filesystems_node_count_check']
    `(state = ANY (ARRAY['active'::text, 'deleting'::text, 'deleted'::text]))` [name: 'filesystems_state_check']
  }

  Indexes {
    (bucket_id, id) [type: btree, name: "filesystems_bucket"]
  }
}

Table "nodes" {
  Note: 'Unified tree of directories, original files and read-only artifact descendants. Original files may have children. Semantic metadata belongs to the corresponding files row; directory rows have none. name uses the PostgreSQL C collation for case-sensitive sibling identity.'

  "id" uuid [pk, not null]
  "filesystem_id" uuid [not null]
  "parent_id" uuid
  "name" text [not null]
  "kind" text [not null]
  "size_bytes" bigint [not null, default: 0]
  "revision" bigint [not null, default: 1]
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]

  Checks {
    `(kind = ANY (ARRAY['file'::text, 'directory'::text]))` [name: 'nodes_kind_check']
    `(((octet_length(name) >= 1) AND (octet_length(name) <= 255)) AND (name <> ALL (ARRAY['.'::text, '..'::text])) AND (POSITION(('/'::text) IN (name)) = 0))` [name: 'nodes_name_check']
    `(revision > 0)` [name: 'nodes_revision_check']
    `(size_bytes >= 0)` [name: 'nodes_size_bytes_check']
  }

  Indexes {
    (filesystem_id, id) [unique, name: "nodes_filesystem_id_id_key"]
    (filesystem_id, parent_id, name) [unique, name: "nodes_filesystem_id_parent_id_name_key"]
    (filesystem_id, id) [type: btree, name: "nodes_detached_roots", note: 'Partial index predicate: (parent_id IS NULL)']
  }
}

Table "object_deletions" {
  Note: 'Asynchronous cleanup ledger for immutable object keys, including ambiguous remote writes and delayed deletion eligibility.'

  "object_key" text [pk, not null]
  "bucket_id" uuid [not null]
  "eligible_at" timestamptz [not null, default: `now()+'00:15:00'::interval`]
  "state" text [not null, default: `'pending'::text`]
  "ambiguous_write" boolean [not null, default: false]
  "open_writes" bigint [not null, default: 0, check: `open_writes >= 0`, note: 'Unresolved backend writes. Process death retains evidence.']
  "updated_at" timestamptz [not null, default: `now()`]

  Checks {
    `(state = ANY (ARRAY['pending'::text, 'deleting'::text, 'deleted'::text]))` [name: 'object_deletions_state_check']
  }

  Indexes {
    (bucket_id, eligible_at) [type: btree, name: "object_deletions_backlog", note: 'Partial index predicate: state <> \'deleted\'::text OR ambiguous_write OR open_writes > 0']
    (eligible_at, object_key) [type: btree, name: "object_deletions_due"]
  }
}

Table "index_deletions" {
  Note: 'Generation cleanup intent survives file deletion; compact tombstones reconcile uncertain late remote writes.'
  "file_id" uuid [not null, note: 'Historical source identity; cleanup survives deletion of the files/nodes row. The blue relationship is not an enforced FK.']
  "generation" bigint [not null, check: `generation > 0`]
  "eligible_at" timestamptz [not null, default: `now()`]
  Indexes {
    (file_id, generation) [pk]
    eligible_at [name: 'index_deletions_due']
  }
}

Table "quota_buckets" {
  Note: 'Logical storage quota and usage accounting. A frozen bucket rejects growth while deletion drains its filesystems.'

  "id" uuid [pk, not null]
  "limit_bytes" bigint [not null]
  "used_bytes" bigint [not null, default: 0]
  "state" text [not null, default: `'active'::text`]
  "created_at" timestamptz [not null, default: `now()`]

  Checks {
    `(limit_bytes >= 0)` [name: 'quota_buckets_limit_bytes_check']
    `(state = ANY (ARRAY['active'::text, 'frozen'::text, 'deleted'::text]))` [name: 'quota_buckets_state_check']
    `(used_bytes >= 0)` [name: 'quota_buckets_used_bytes_check']
  }
}

Table "trash_entries" {
  Note: 'Detached trash roots and restore metadata. original_parent_id may no longer exist; the original name is preserved for conflict-aware restoration.'

  "id" uuid [pk, not null]
  "filesystem_id" uuid [not null]
  "node_id" uuid [unique, not null]
  "original_parent_id" uuid [note: 'Historical restore location; the parent can be deleted independently.']
  "original_name" text [not null]
  "actor_id" uuid [not null]
  "state" text [not null, default: `'trashed'::text`]
  "created_at" timestamptz [not null, default: `now()`]

  Checks {
    `(state = ANY (ARRAY['trashed'::text, 'purging'::text]))` [name: 'trash_entries_state_check']
  }

  Indexes {
    (filesystem_id, id) [type: btree, name: "trash_page"]
  }
}

Table "uploads" {
  Note: 'Inline, single-object and multipart upload lifecycle. input stores the destination and overwrite preconditions. Parse/enrichment outputs reuse this table with explicit processing ownership.'

  "id" uuid [pk, not null]
  "filesystem_id" uuid [not null]
  "bucket_id" uuid [not null]
  "actor_id" uuid
  "input" jsonb [not null]
  "candidate_key" text [unique]
  "state" text [not null, default: `'open'::text`]
  "expires_at" timestamptz [not null, default: `now()+'01:00:00'::interval`]
  "transfer_deadline" timestamptz
  "inline_bytes" bytea
  "result_node_id" uuid [note: 'Published output identity; the node can later be deleted while this upload receipt remains.']
  "created_at" timestamptz [not null, default: `now()`]
  "updated_at" timestamptz [not null, default: `now()`]
  "transport" text [not null]
  "expected_size" bigint
  "content_md5" text
  "multipart_id" text
  "part_size" bigint
  "completion_parts" jsonb
  "result" jsonb
  "processing_file_id" uuid [note: 'Source file identity for parse/enrichment output; may outlive the source row.']
  "processing_generation" bigint
  "relative_path" text
  "processing_stage" text

  Checks {
    `((expected_size IS NOT NULL) AND (expected_size >= 0))` [name: 'uploads_direct_metadata']
    `(((transport = 'inline'::text) AND (candidate_key IS NULL) AND (multipart_id IS NULL) AND (part_size IS NULL) AND (content_md5 IS NULL) AND (transfer_deadline IS NULL)) OR ((transport = 'single'::text) AND (candidate_key IS NOT NULL) AND (multipart_id IS NULL) AND (part_size IS NULL) AND (content_md5 IS NOT NULL)) OR ((transport = 'multipart'::text) AND (candidate_key IS NOT NULL) AND (part_size IS NOT NULL) AND (part_size >= 5242880) AND (content_md5 IS NULL)))` [name: 'uploads_object_identity']
    `(actor_id IS NOT NULL AND processing_file_id IS NULL AND processing_generation IS NULL AND relative_path IS NULL AND processing_stage IS NULL) OR (processing_file_id IS NOT NULL AND processing_generation IS NOT NULL AND processing_generation > 0 AND relative_path IS NOT NULL AND processing_stage IS NOT NULL AND processing_stage IN ('parse','enrichment'))` [name: 'uploads_processing_owner']
    `(state = ANY (ARRAY['open'::text, 'completing'::text, 'finalized'::text, 'aborted'::text]))` [name: 'uploads_state_check']
    `state != 'finalized' OR result IS NOT NULL` [name: 'uploads_finalized_result']
    `(transport = ANY (ARRAY['inline'::text, 'single'::text, 'multipart'::text]))` [name: 'uploads_transport']
  }

  Indexes {
    (updated_at, id) [type: btree, name: "uploads_multipart_cleanup", note: 'Partial index predicate: ((state = ANY (ARRAY[\'aborted\'::text])) AND (multipart_id IS NOT NULL))']
    (bucket_id, state, expires_at) [type: btree, name: "uploads_outstanding", note: 'Partial index predicate: (state = ANY (ARRAY[\'open\'::text, \'completing\'::text]))']
  }
}

// Physical foreign-key relationships in the implemented schema.
Ref membership_workspace: workspace_members.workspace_id > workspaces.id
Ref workspace_operation_scope: workspace_idempotency_keys.workspace_id > workspaces.id
Ref invitation_workspace: workspace_invitations.workspace_id > workspaces.id
Ref file_payload: files.node_id - nodes.id [delete: cascade]
Ref filesystem_root: filesystems.(id, root_id) > nodes.(filesystem_id, id)
Ref filesystem_quota: filesystems.bucket_id > quota_buckets.id
Ref node_filesystem: nodes.filesystem_id > filesystems.id
Ref node_parent: nodes.(filesystem_id, parent_id) > nodes.(filesystem_id, id)
Ref object_cleanup_quota: object_deletions.bucket_id > quota_buckets.id
Ref trash_filesystem: trash_entries.filesystem_id > filesystems.id
Ref trash_node_scope: trash_entries.(filesystem_id, node_id) > nodes.(filesystem_id, id)
Ref trash_root: trash_entries.node_id - nodes.id
Ref upload_quota: uploads.bucket_id > quota_buckets.id
Ref upload_filesystem: uploads.filesystem_id > filesystems.id

// Logical application relationships for the monolith view; current DDL has no physical FKs for these.
Ref logical_initial_workspace: users.initial_workspace_id - workspaces.id [color: #5B8FF9]
Ref logical_membership_user: workspace_members.user_id > users.id [color: #5B8FF9]
Ref logical_invitation_acceptor: workspace_invitations.accepted_user_id > users.id [color: #5B8FF9]
Ref logical_workspace_initiator: workspace_idempotency_keys.actor_id > users.id [color: #5B8FF9]
Ref logical_storage_quota: workspaces.quota_bucket_id - quota_buckets.id [color: #5B8FF9]
Ref logical_storage_filesystem: workspaces.filesystem_id - filesystems.id [color: #5B8FF9]
Ref logical_storage_root: workspaces.root_id - nodes.id [color: #5B8FF9]
Ref logical_upload_actor: uploads.actor_id > users.id [color: #5B8FF9]
Ref logical_trash_actor: trash_entries.actor_id > users.id [color: #5B8FF9]
Ref logical_upload_result: uploads.result_node_id > nodes.id [color: #5B8FF9]
Ref logical_processing_source: uploads.processing_file_id > files.node_id [color: #5B8FF9]
Ref logical_restore_parent: trash_entries.original_parent_id > nodes.id [color: #5B8FF9]
Ref logical_index_cleanup_source: index_deletions.file_id > files.node_id [color: #5B8FF9]

TableGroup Identity {
  users
}

TableGroup Collaboration {
  workspaces
  workspace_members
  workspace_invitations
  workspace_idempotency_keys
}

TableGroup FileStorage {
  letfs_idempotency_keys
  quota_buckets
  filesystems
  nodes
  files
  trash_entries
  uploads
}

TableGroup ProcessingAndRecovery {
  object_deletions
  index_deletions
}
