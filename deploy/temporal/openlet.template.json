{
  "log": {
    "level": "warn",
    "outputFile": ""
  },
  "persistence": {
    "defaultStore": "default",
    "visibilityStore": "visibility",
    "numHistoryShards": 4,
    "datastores": {
      "default": {
        "sql": {
          "pluginName": "postgres12_pgx",
          "databaseName": "openlet_temporal",
          "connectAddr": "postgres:5432",
          "connectProtocol": "tcp",
          "user": "openlet_temporal",
          "password": "__SECRET__",
          "maxConns": 10,
          "maxIdleConns": 2
        }
      },
      "visibility": {
        "sql": {
          "pluginName": "postgres12_pgx",
          "databaseName": "openlet_temporal_visibility",
          "connectAddr": "postgres:5432",
          "connectProtocol": "tcp",
          "user": "openlet_temporal_visibility",
          "password": "__SECRET__",
          "maxConns": 10,
          "maxIdleConns": 2
        }
      }
    }
  },
  "global": {
    "membership": {
      "maxJoinDuration": "30s",
      "broadcastAddress": "0.0.0.0"
    }
  },
  "services": {
    "frontend": {
      "rpc": {
        "grpcPort": 7233,
        "membershipPort": 8233,
        "bindOnIP": "0.0.0.0"
      }
    },
    "history": {
      "rpc": {
        "grpcPort": 7234,
        "membershipPort": 8234,
        "bindOnIP": "0.0.0.0"
      }
    },
    "matching": {
      "rpc": {
        "grpcPort": 7235,
        "membershipPort": 8235,
        "bindOnIP": "0.0.0.0"
      }
    },
    "worker": {
      "rpc": {
        "grpcPort": 7239,
        "membershipPort": 8239,
        "bindOnIP": "0.0.0.0"
      }
    }
  },
  "clusterMetadata": {
    "enableGlobalNamespace": false,
    "failoverVersionIncrement": 10,
    "masterClusterName": "active",
    "currentClusterName": "active",
    "clusterInformation": {
      "active": {
        "enabled": true,
        "initialFailoverVersion": 1,
        "rpcName": "frontend",
        "rpcAddress": "temporal:7233"
      }
    }
  },
  "dcRedirectionPolicy": {
    "policy": "noop"
  },
  "publicClient": {
    "hostPort": "temporal:7233"
  }
}
