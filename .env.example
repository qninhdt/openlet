# Non-secret settings. Generate service credentials with scripts/bootstrap/configure.py.
JWT_ISSUER=https://YOUR-CLERK-INSTANCE.clerk.accounts.dev
JWKS_URL=https://YOUR-CLERK-INSTANCE.clerk.accounts.dev/.well-known/jwks.json
JWT_AUDIENCE=openlet
GATEWAY_RATE=100
GATEWAY_BURST=200
MAX_NODES=1000000
INLINE_LIMIT_BYTES=262144
MAX_FILE_BYTES=104857600
MAX_OUTSTANDING_STORAGE=16
MAX_CLEANUP_BACKLOG=10000
MAX_COPY_NODES=10000
PROCESSING_MAX_OUTPUTS=512
PROCESSING_MAX_OUTPUT_BYTES=268435456
MAX_OWNED_WORKSPACES=100
MAX_MEMBERS=100
DEFAULT_QUOTA_BYTES=10737418240
INVITE_TTL=168h
S3_ENDPOINT=https://YOUR-PRIVATE-S3-ENDPOINT
# Optional exact caller-reachable endpoint; defaults to S3_ENDPOINT. Never rewrite signed URLs.
# S3_SIGNING_ENDPOINT=https://YOUR-CALLER-REACHABLE-S3-ENDPOINT
DOWNLOAD_URL_TTL_SECONDS=300
UPLOAD_URL_TTL_SECONDS=900
UPLOAD_TRANSFER_GRACE_SECONDS=3600
MULTIPART_THRESHOLD_BYTES=16777216
MULTIPART_PART_BYTES=8388608
S3_REGION=us-east-1
S3_BUCKET=openlet
# Set CLERK_SECRET_KEY, S3_ACCESS_KEY_ID, S3_SECRET_ACCESS_KEY and OPENROUTER_API_KEY in your shell.
# configure.py copies them into ignored secret files; never commit real values.

# Streamed ZIP download limits
ARCHIVE_MAX_ENTRIES=10000
ARCHIVE_MAX_SOURCE_BYTES=1073741824
ARCHIVE_MAX_OUTPUT_BYTES=1107296256
ARCHIVE_MAX_CONCURRENT=2
ARCHIVE_RUNTIME_SECONDS=1200

# AI generation/vision, embeddings and reranking use OpenRouter.
OPENROUTER_GENERATION_MODEL=openai/gpt-4.1-mini
OPENROUTER_REASONING_EFFORT=
OPENROUTER_EMBEDDING_MODEL=openai/text-embedding-3-small
OPENROUTER_RERANK_MODEL=cohere/rerank-v3.5
EMBEDDING_DIMENSION=1536
QDRANT_COLLECTION=files
AI_EVIDENCE_TOKENS=4096
AI_CONCURRENCY=4
EMBEDDING_BATCH_SIZE=16
CHUNK_TOKENS=1024
CHUNK_OVERLAP_TOKENS=128
MIN_LEAF_TOKENS=256
SPLIT_TOKENS=4096

# Optional OpenTelemetry; an empty endpoint disables export in every app.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=grpc
OTEL_EXPORTER_OTLP_HEADERS=
OTEL_TRACES_SAMPLER=parentbased_always_on
OTEL_TRACES_SAMPLER_ARG=1
OTEL_RESOURCE_ATTRIBUTES=deployment.environment.name=development
OTEL_SDK_DISABLED=false
