# Clerk: backend authentication.
CLERK_SECRET_KEY=

# Cloudflare R2: bucket-scoped S3 Object Read & Write credentials.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Model provider.
OPENAI_BASE_URL=
OPENAI_API_KEY=
# Internal LiteLLM Proxy authentication, independent of upstream credentials.
LITELLM_MASTER_KEY=

# Langfuse project credentials.
# Set the CLI URL to the same regional host as langfuse.base_url in the YAML.
# Examples: https://cloud.langfuse.com or https://us.cloud.langfuse.com
LANGFUSE_BASE_URL=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# Grafana Cloud runtime token: metrics:write, logs:write and traces:write.
GRAFANA_CLOUD_TOKEN=

# Local infrastructure: use independently generated random secrets.
POSTGRES_ADMIN_PASSWORD=
PLATFORM_DB_PASSWORD=
LETFS_DB_PASSWORD=
LETA_DB_PASSWORD=
TEMPORAL_DB_PASSWORD=
SPICEDB_DB_PASSWORD=
OBSERVABILITY_DB_PASSWORD=
SPICEDB_KEY=
QDRANT_API_KEY=
REDIS_PASSWORD=
