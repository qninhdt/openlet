# Optional AI & external service credentials for local development (`make dev`).
# Without OPENAI_API_KEY, `make dev` automatically falls back to offline mock mode.
# All internal database, SpiceDB, Qdrant, Redis, and RustFS secrets are auto-generated
# per project under `.local/env/<project>/secrets.env`.

OPENAI_BASE_URL=
OPENAI_API_KEY=
DATALAB_API_KEY=
TINYFISH_API_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
