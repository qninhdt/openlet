{
  "name": "openlet",
  "private": true,
  "packageManager": "pnpm@12.18.0",
  "scripts": {
    "dev": "pnpm --filter @openlet/web dev",
    "build": "pnpm --filter @openlet/web build",
    "preview": "pnpm --filter @openlet/web preview",
    "lint": "pnpm --filter @openlet/web lint",
    "test:web": "pnpm --filter @openlet/e2e test:web",
    "typecheck": "pnpm -r --if-present typecheck",
    "format": "prettier --write \"e2e/**/*.{js,ts,mjs,cjs}\" \"apps/web/**/*.{js,ts,tsx,json,css,html,md}\" package.json",
    "format:check": "prettier --check \"e2e/**/*.{js,ts,mjs,cjs}\" \"apps/web/**/*.{js,ts,tsx,json,css,html,md}\" package.json"
  },
  "devDependencies": {
    "prettier": "3.10.1"
  }
}
